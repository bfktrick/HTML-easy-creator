{
  "name": "html-creator",
  "version": "1.1.0",
  "description": "Chat that turns a guide, document or idea into a ready-to-publish HTML page.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "app": "vite build && node server/index.ts --window",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "agent": "node scripts/build-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "mammoth": "1.13.0",
    "openai": "7.62.0",
    "parse5": "8.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
